# 원격 PostgreSQL 접속 문자열
DATABASE_URL="postgresql://postgres:postgres@your-remote-db-host:5432/family_tree?schema=public"

# 운영 환경(NODE_ENV=production)에서는 반드시 긴 랜덤 문자열로 설정하세요.
# 생성 예시: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret-string"

# 초기 관리자(ADMIN)로 자동 지정할 이메일 목록 (쉼표로 구분 가능)
ADMIN_EMAIL=""
