# PostgreSQL (Docker Compose 사용 시 호스트명은 db, 로컬 실행 시 localhost)
DATABASE_URL="postgresql://postgres:postgres@db:5432/family_tree?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="family_tree"

# 운영 환경(NODE_ENV=production)에서는 반드시 긴 랜덤 문자열로 설정하세요.
# 생성 예시: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret-string"
